{
  "permissions": {
    "allow": [
      "Read(.canon/)",
      "Write(.canon/)",
      "Edit(.canon/)",
      "Bash(.canon/)",
      "Bash(git add)",
      "Bash(git commit)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git worktree)",
      "Bash(git branch)",
      "Bash(git checkout)",
      "Bash(git merge)",
      "Bash(git rev-parse)",
      "Bash(npm test)",
      "Bash(npm run)",
      "Bash(npx vitest)",
      "Bash(npx biome)",
      "Read(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Read(**/context.md)",
      "Write(**/context.md)",
      "Edit(**/context.md)",
      "Read(**/CONVENTIONS.md)",
      "Write(**/CONVENTIONS.md)",
      "Edit(**/CONVENTIONS.md)",
      "Read(**/README.md)",
      "Edit(**/README.md)",
      "mcp__canon__*",
      "mcp__canon-marketplace__*",
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch"
    ]
  },
  "env": {},
  "enabledPlugins": {
    "canon@canon-marketplace": true
  }
}
