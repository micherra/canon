{
  "name": "@canon/mcp-server",
  "version": "2.17.0",
  "description": "MCP server for Canon engineering principles",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/app/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "cd .. && biome check mcp-server/src/",
    "lint:deps": "depcruise --validate .dependency-cruiser.cjs src/",
    "lint:fix": "cd .. && biome check --write mcp-server/src/",
    "lint:types": "tsc -p tsconfig.lint.json",
    "regen:context-manifest": "tsx scripts/regen-context-manifest.ts",
    "start": "tsx src/app/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "graphology": "^0.26",
    "graphology-communities-louvain": "^2.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "web-tree-sitter": "^0.26.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "dependency-cruiser": "^18.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "protobufjs": "^7.6.4"
  }
}
