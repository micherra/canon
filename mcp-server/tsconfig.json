{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@app/*": ["app/*"],
      "@domains/*": ["domains/*"],
      "@features/*": ["features/*"],
      "@graph/*": ["graph/*"],
      "@platform/*": ["platform/*"],
      "@shared/*": ["shared/*"],
      "@tests/*": ["tests/*"],
      "@ui/*": ["ui/*"]
    },

    "strict": true,
    "ignoreDeprecations": "6.0",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/ui"]
}
