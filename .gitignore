# Canon local data (dogfooding — ignore .canon directory contents)
# Using .canon/** instead of .canon/ so git traverses the directory and
# the negation pattern !.canon/principle-overrides.yaml works reliably.
**/.canon/**
!.canon/principle-overrides.yaml
.env

# Ephemeral workspace artifacts (covered by .canon/** above)

# Local Node version manager pins (asdf, nvm, etc.) — never ship a hard pin
.tool-versions
