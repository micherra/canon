{
  "name": "@canon/mcp-server",
  "version": "2.1.1",
  "description": "MCP server for Canon engineering principles",
  "type": "module",
  "main": "src/app/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "cd .. && biome check mcp-server/src/",
    "lint:deps": "depcruise --validate .dependency-cruiser.cjs src/",
    "lint:fix": "cd .. && biome check --write mcp-server/src/",
    "lint:types": "tsc -p tsconfig.lint.json",
    "start": "tsx src/app/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "graphology": "^0.26",
    "graphology-communities-louvain": "^2.0.2",
    "gray-matter": "^4.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "web-tree-sitter": "^0.26.8",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@biomejs/biome": "2.4.10",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "dependency-cruiser": "^17.3.10",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "^3",
    "svelte": "^5.55.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.2"
  }
}
