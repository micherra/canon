{
  "name": "@canon/mcp-server",
  "version": "2.24.1",
  "description": "MCP server for Canon engineering principles",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/app/index.ts",
  "scripts": {
    "backfill:review-extraction": "tsx scripts/backfill-review-extraction.ts",
    "build": "tsc",
    "lint": "cd .. && biome check mcp-server/src/",
    "lint:deps": "depcruise --validate .dependency-cruiser.cjs src/",
    "lint:fix": "cd .. && biome check --write mcp-server/src/",
    "lint:types": "tsc -p tsconfig.lint.json",
    "regen:context-manifest": "tsx scripts/regen-context-manifest.ts",
    "start": "tsx src/app/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "graphology": "^0.26",
    "graphology-communities-louvain": "^2.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.23.13",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "dependency-cruiser": "^18.3.1",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "protobufjs": "^7.6.4",
    "adm-zip": "^0.6.0"
  }
}
