diff --git a/src/services/receipt.ts b/src/services/receipt.ts
index cccc1111..dddd2222 100644
--- a/src/services/receipt.ts
+++ b/src/services/receipt.ts
@@ -1,3 +1,11 @@
 export type ReceiptResult =
   | { ok: true; receiptId: string }
   | { ok: false; error: "order_not_found" };
+
+export function buildReceipt(orderId: string, orders: Map<string, { total: number }>): ReceiptResult {
+  const order = orders.get(orderId);
+  if (!order) {
+    return { ok: false, error: "order_not_found" };
+  }
+  return { ok: true, receiptId: "rcpt_" + orderId };
+}
