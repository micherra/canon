{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "context-manifest.json", "jsonpath": "$.version" },
        { "type": "json", "path": "mcp-server/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "mcp-server/src/app/create-server.ts" },
        { "type": "json", "path": "mcp-server/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "mcp-server/package-lock.json", "jsonpath": "$[\"packages\"][\"\"][\"version\"]" }
      ]
    }
  }
}
