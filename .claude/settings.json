{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Edit(.canon/)",
      "Write(.canon/)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/context.md)",
      "Write(**/context.md)",
      "Edit(**/CONVENTIONS.md)",
      "Write(**/CONVENTIONS.md)",
      "Edit(**/README.md)",
      "Bash(.canon/)",
      "Bash(git add)",
      "Bash(git commit)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git show)",
      "Bash(git worktree)",
      "Bash(git branch)",
      "Bash(git checkout)",
      "Bash(git merge)",
      "Bash(git rev-parse)",
      "Bash(git fetch)",
      "Bash(git stash)",
      "Bash(npm test)",
      "Bash(npm run)",
      "Bash(npx vitest)",
      "Bash(npx biome)",
      "Bash(npx tsc)",
      "Bash(gh pr)",
      "Bash(gh run)",
      "Bash(mkdir -p)",
      "Bash(open .canon/)",
      "mcp__canon__*",
      "mcp__canon-marketplace__*"
    ]
  },
  "env": {},
  "enabledPlugins": {
    "canon@canon-marketplace": true
  }
}
